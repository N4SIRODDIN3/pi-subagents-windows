{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "noImplicitAny": true,
    "skipLibCheck": true,
    "types": ["node", "bun"],
    "lib": ["ES2023", "DOM"]
  },
  "include": [
    "../index.ts",
    "../extensions/subagents/**/*.ts"
  ]
}
